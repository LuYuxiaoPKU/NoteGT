{
	"schemaVersion": 1,
	"id": "notegt",
	"version": "0.1.0",
	"name": "NoteGT",
	"description": "Note-block sound optimization for Minecraft: per-instrument L0 sample shaping routing, L1 voice merge (2gt window + release-cancel), L2 loop sustain. Client-side only.",
	"authors": [
		"LuYuxiaoPKU"
	],
	"contact": {
		"sources": "https://github.com/LuYuxiaoPKU/NoteGT"
	},
	"license": "CC0-1.0",
	"icon": "assets/notegt/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.notegt.NoteGTMod"
		],
		"client": [
			"com.notegt.client.NoteGTClient"
		]
	},
	"mixins": [
		"notegt.mixins.json",
		{
			"config": "notegt.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
