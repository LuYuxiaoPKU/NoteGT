+def fade_quality(src_head, src_tail):
+    """被交叉淡化混合的两段：同相程度 + 混合后电平塌陷
+
+    ncc 低 / dip 大 => 淡化区出现随循环率重复的凹陷（真实可闻），
+    这是启用淡化后唯一还能反映周期性误差的指标。
+    """
